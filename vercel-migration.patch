diff --git a/vercel.json b/vercel.json
new file mode 100644
index 0000000..7ad79f2
--- /dev/null
+++ b/vercel.json
@@ -0,0 +1,16 @@
+{
+  "$schema": "https://openapi.vercel.sh/vercel.json",
+  "buildCommand": "pnpm install --frozen-lockfile=false && pnpm --filter @workspace/aa-meetings run build",
+  "outputDirectory": "artifacts/aa-meetings/dist/public",
+  "installCommand": "echo skip-default-install",
+  "functions": {
+    "api/index.ts": {
+      "memory": 1024,
+      "maxDuration": 15
+    }
+  },
+  "rewrites": [
+    { "source": "/api/(.*)", "destination": "/api" },
+    { "source": "/((?!api/).*)", "destination": "/index.html" }
+  ]
+}
